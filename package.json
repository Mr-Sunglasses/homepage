{
	"name": "homepage",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"check": "astro check",
		"lint": "biome check --write ./src ./scripts",
		"test": "node --test",
		"new": "node scripts/new.mjs",
		"promote": "node scripts/promote.mjs",
		"check:drafts": "node scripts/check-no-drafts.mjs",
		"prepare": "git config core.hooksPath .githooks || true",
		"preinstall": "npx only-allow pnpm",
		"photos:import": "node --env-file-if-exists=.env scripts/photos-import.mjs",
		"photos:verify": "node --env-file-if-exists=.env scripts/photos-verify.mjs",
		"stores:dev": "sh scripts/dev-stores.sh",
		"photos:dev:import": "node --env-file=.dev-stores/env scripts/photos-import.mjs",
		"photos:dev:verify": "node --env-file=.dev-stores/env scripts/photos-verify.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.2",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"astro": "7.3.8",
		"aws4fetch": "1.0.20",
		"d3-geo": "3.1.1",
		"exifr": "7.1.3",
		"markdown-it": "14.1.0",
		"mdast-util-to-string": "4.0.0",
		"pagefind": "1.5.2",
		"remark-directive": "3.0.1",
		"sanitize-html": "2.17.6",
		"sharp": "0.34.5",
		"topojson-client": "3.1.0",
		"unist-util-visit": "5.0.0",
		"world-atlas": "2.0.2",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.2.5",
		"@types/d3-geo": "3.1.1",
		"@types/geojson": "7946.0.16",
		"@types/markdown-it": "14.1.2",
		"@types/sanitize-html": "2.16.1",
		"@types/topojson-client": "3.1.5",
		"@types/topojson-specification": "1.0.5",
		"rehype-stringify": "10.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"typescript": "5.9.3",
		"unified": "11.0.5"
	},
	"packageManager": "pnpm@9.14.4"
}
