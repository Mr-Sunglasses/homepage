{
	"name": "homepage",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check",
		"lint": "biome check --write ./src ./scripts",
		"test": "node --test",
		"new": "node scripts/new.mjs",
		"promote": "node scripts/promote.mjs",
		"check:drafts": "node scripts/check-no-drafts.mjs",
		"prepare": "git config core.hooksPath .githooks || true",
		"preinstall": "npx only-allow pnpm"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.2",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"astro": "7.3.8",
		"markdown-it": "14.1.0",
		"mdast-util-to-string": "4.0.0",
		"remark-directive": "3.0.1",
		"sanitize-html": "2.17.6",
		"sharp": "0.34.5",
		"unist-util-visit": "5.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.2.5",
		"@types/markdown-it": "14.1.2",
		"@types/sanitize-html": "2.16.1",
		"rehype-stringify": "10.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"typescript": "5.9.3",
		"unified": "11.0.5"
	},
	"packageManager": "pnpm@9.14.4"
}
