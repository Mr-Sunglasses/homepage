# Netlify response headers. Pages set their own Content-Security-Policy in
# a <meta> tag (search may run scripts, nothing else may).

# Build assets have a content hash in their name: cache them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: browsing-topics=(), interest-cohort=(), camera=(), microphone=(), geolocation=(), payment=(), usb=()
