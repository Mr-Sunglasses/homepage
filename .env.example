# Copy to .env (gitignored) and fill in. Used by `pnpm photos:import` and
# `pnpm photos:verify`; the site itself needs none of this.

# The photo stores, in order. Every photo is uploaded to all of them.
PHOTO_STORES=r2,vps

# Cloudflare R2. Create an API token in R2 → Manage API tokens with
# "Object Read & Write", limited to the `photos` and `originals` buckets.
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_S3_REGION=auto
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
# R2_PHOTOS_BUCKET=photos
# R2_ORIGINALS_BUCKET=originals

# Garage on the VPS (behind Caddy at s3.kanishkk.xyz).
VPS_S3_ENDPOINT=https://s3.kanishkk.xyz
VPS_S3_REGION=garage
VPS_S3_ACCESS_KEY_ID=
VPS_S3_SECRET_ACCESS_KEY=
# VPS_PHOTOS_BUCKET=photos
# VPS_ORIGINALS_BUCKET=originals

# Where the site loads photos from. Only needed to override the default
# (https://photos.kanishkk.xyz); `pnpm stores:dev up` sets it for local work.
# PUBLIC_PHOTOS_URL=
