---
import { elsewhere, nav, site } from "@/config";
import { CARD, cardAlt, cardPath } from "@/lib/og.mjs";
import "@/styles/global.css";

export type Crumb = { label: string; href?: string };

interface Props {
	title?: string;
	description?: string;
	// The page's own share image, best at 1200×630. Without one, a page gets
	// a card with its title, drawn after the build (src/lib/og.mjs); the
	// homepage gets public/og.jpg.
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	// An image to show inside the generated card: a cover that doesn't suit
	// a link preview as it is (too small, square, portrait).
	cardImage?: string;
	// Articles: when published and last changed, and their tags.
	published?: Date;
	modified?: Date;
	tags?: string[];
	crumbs?: Crumb[];
	isDraft?: boolean;
	type?: "website" | "article";
	// Include this page in site search (entries, not lists).
	searchable?: boolean;
	// The page runs its own scripts (only search does); every other page is
	// forbidden from running any.
	scripts?: boolean;
}

const {
	title,
	description = site.description,
	image,
	imageAlt,
	imageWidth,
	imageHeight,
	cardImage,
	published,
	modified,
	tags = [],
	crumbs = [],
	isDraft = false,
	type = "website",
	searchable = false,
	scripts = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

// What's shown when the page is shared.
const card = cardPath(path);
const share = image
	? {
			url: image,
			alt: imageAlt ?? title ?? site.name,
			width: imageWidth,
			height: imageHeight,
		}
	: card
		? { url: card, alt: cardAlt(title ?? site.name, path, site.name), ...CARD }
		: {
				url: "/og.jpg",
				alt: `${site.name}: photo, name and introduction`,
				...CARD,
			};
const imageUrl = new URL(share.url, Astro.site);
const cardImageUrl =
	!image && card && cardImage ? new URL(cardImage, Astro.site) : undefined;
const xHandle = elsewhere
	.find((item) => item.label === "X")
	?.href.replace(/^https:\/\/(x|twitter)\.com\//, "@");
const day = (date: Date) => date.toISOString().slice(0, 10);
const article = type === "article";

// Structured data for search engines: who I am on the homepage, and what
// each dated article is.
const me = {
	"@type": "Person",
	"@id": `${site.url}/#me`,
	name: site.name,
	alternateName: site.title,
	url: `${site.url}/`,
	description: site.intro,
	sameAs: elsewhere.filter((item) => item.me).map((item) => item.href),
};
const jsonLd =
	path === "/"
		? {
				"@context": "https://schema.org",
				"@graph": [
					me,
					{
						"@type": "WebSite",
						"@id": `${site.url}/#site`,
						url: `${site.url}/`,
						name: site.name,
						description,
						inLanguage: site.lang,
						publisher: { "@id": me["@id"] },
					},
				],
			}
		: article && (published || modified) && !isDraft
			? {
					"@context": "https://schema.org",
					"@type": "BlogPosting",
					headline: title,
					description,
					url: canonical.href,
					mainEntityOfPage: canonical.href,
					datePublished: published && day(published),
					dateModified: day((modified ?? published) as Date),
					image: imageUrl.href,
					author: { "@type": "Person", name: site.name, url: `${site.url}/` },
					keywords: tags.length > 0 ? tags.join(", ") : undefined,
					inLanguage: site.lang,
				}
			: undefined;
// "<" escaped, so nothing in a title can close the script element.
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replaceAll("<", "\\u003c");
const current = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href);

// What a page may load: only this site and the photo host, never another
// site's scripts, fonts or trackers. Not in dev, where Vite injects scripts.
const photos = new URL(
	import.meta.env.PUBLIC_PHOTOS_URL ?? "https://photos.kanishkk.xyz",
).origin;
const csp = [
	"default-src 'self'",
	`img-src 'self' data: ${photos}`,
	"style-src 'self' 'unsafe-inline'",
	scripts ? "script-src 'self' 'wasm-unsafe-eval'" : "script-src 'none'",
	"object-src 'none'",
	"base-uri 'self'",
	"form-action 'self'",
].join("; ");
---

<!doctype html>
<html lang={site.lang}>
	<head>
		<meta charset="utf-8" />
		{!import.meta.env.DEV && <meta http-equiv="Content-Security-Policy" content={csp} />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{isDraft && <meta name="robots" content="noindex, nofollow" />}
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#fff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#01242e" media="(prefers-color-scheme: dark)" />
		<link rel="author" href="/" />
		<link rel="license" href={site.license.url} />

		<meta property="og:site_name" content={site.name} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title ?? site.name} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={site.locale} />
		<meta property="og:image" content={imageUrl} />
		{share.width && <meta property="og:image:width" content={String(share.width)} />}
		{share.height && <meta property="og:image:height" content={String(share.height)} />}
		<meta property="og:image:alt" content={share.alt} />
		{cardImageUrl && <meta property="og:image" content={cardImageUrl} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={share.alt} />
		{xHandle && <meta name="twitter:creator" content={xHandle} />}
		{article && published && <meta property="article:published_time" content={day(published)} />}
		{article && modified && <meta property="article:modified_time" content={day(modified)} />}
		{article && <meta property="article:author" content={`${site.url}/`} />}
		{article && tags.map((tag) => <meta property="article:tag" content={tag} />)}
		{jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
		<meta name="fediverse:creator" content={site.fediverse.handle.slice(1)} />
		<link rel="me" href={site.fediverse.url} />

		<link rel="alternate" type="application/rss+xml" title={`${site.name}: everything`} href="/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href="/writing/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${site.name}: notes`} href="/notes/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${site.name}: links`} href="/links/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${site.name}: TILs`} href="/tils/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${site.name}: travel`} href="/travel/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${site.name}: positions`} href="/positions/rss.xml" />

		<link rel="icon" href="/favicon/favicon-light-32.png" sizes="32x32" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/favicon/favicon-dark-32.png" sizes="32x32" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/favicon/favicon-light-180.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="site-header" data-pagefind-ignore>
			<a class="site-name" href="/">{site.title} <span aria-hidden="true">🐈</span></a>
			<nav class="site-nav" aria-label="Sections">
				<ul>
					{
						nav.map((item) => (
							<li>
								<a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		{
			crumbs.length > 0 && (
				<nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
					<ol>
						<li>
							<a href="/">Home</a>
						</li>
						{crumbs.map((crumb) => (
							<li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>
						))}
					</ol>
				</nav>
			)
		}

		<main id="main" data-pagefind-body={searchable && !isDraft ? "" : undefined}>
			{isDraft && <p class="draft-bar">DRAFT: only visible on this machine. Publish with <code>pnpm promote</code>.</p>}
			<slot />
		</main>

		<footer class="site-footer" data-pagefind-ignore>
			<ul class="inline-list">
				{elsewhere.map((item) => <li><a href={item.href} rel={item.me ? "me" : undefined}>{item.label}</a></li>)}
			</ul>
			<p>
				Content <a href={site.license.url} rel="license">{site.license.name}</a> · No tracking · No JavaScript needed
				· <a href={site.source}>Source</a> (AGPL)
			</p>
		</footer>
	</body>
</html>
