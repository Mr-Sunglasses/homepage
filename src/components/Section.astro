---
import Row from "@/components/Row.astro";
import type { Item } from "@/lib/content";

// A homepage block: heading, the latest rows, and a link to the rest.
interface Props {
	title: string;
	href: string;
	more: string;
	items: Item[];
	empty: string;
}

const { title, href, more, items, empty } = Astro.props;
---

<section>
	<div class="section-head">
		<h2><a href={href}>{title}</a></h2>
		<a href={href}>{more} →</a>
	</div>
	{
		items.length > 0 ? (
			<ul class="rows">
				{items.map((item) => (
					<Row item={item} />
				))}
			</ul>
		) : (
			<p class="empty">{empty}</p>
		)
	}
	<slot />
</section>
