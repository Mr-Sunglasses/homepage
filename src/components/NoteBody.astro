---
import { render } from "astro:content";
import Confidence from "@/components/Confidence.astro";
import { domainOf, isoDate, type Note, noteUrl } from "@/lib/content";

// One note in full. Notes with `link` lead with the thing being commented on.
interface Props {
	note: Note;
	headingLevel?: 1 | 2;
}

const { note, headingLevel = 2 } = Astro.props;
const { Content } = await render(note);
const { date, title, link, linkTitle } = note.data;
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<article class="note h-entry" id={note.id.split("/").pop()}>
	<p class="meta">
		<a class="u-url" href={noteUrl(note)}><time class="dt-published" datetime={isoDate(date)}>{isoDate(date)}</time></a>
		<Confidence level={note.data.confidence} />
		{note.isDraft && <span class="draft-mark">draft</span>}
	</p>
	{
		link ? (
			<Heading>
				<span aria-hidden="true">↗</span> <a class="u-bookmark-of" href={link}>{linkTitle ?? title ?? domainOf(link)}</a>
				{(linkTitle ?? title) && <span class="meta"> ({domainOf(link)})</span>}
			</Heading>
		) : (
			title && <Heading class="p-name">{title}</Heading>
		)
	}
	<div class="e-content">
		<Content />
	</div>
	<slot />
</article>
