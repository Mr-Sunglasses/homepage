---
import type { GetStaticPaths } from "astro";
import YearList from "@/components/YearList.astro";
import Base from "@/layouts/Base.astro";
import { getAllItems, tagSlug } from "@/lib/content";

export const getStaticPaths = (async () => {
	const items = await getAllItems();
	const slugs = new Map<string, string>();
	for (const tag of items.flatMap((item) => item.tags)) {
		if (!slugs.has(tagSlug(tag))) slugs.set(tagSlug(tag), tag);
	}
	return [...slugs.entries()].map(([slug, name]) => ({
		params: { tag: slug },
		props: {
			name,
			items: items.filter((item) => item.tags.some((t) => tagSlug(t) === slug)),
		},
	}));
}) satisfies GetStaticPaths;

const { name, items } = Astro.props;
---

<Base title={`Tagged “${name}”`} crumbs={[{ label: "Tags", href: "/tags/" }, { label: name }]}>
	<h1>Tagged “{name}”</h1>
	<YearList items={items} showSection />
</Base>
