---
import NoteBody from "@/components/NoteBody.astro";
import Base from "@/layouts/Base.astro";
import { getNotes, isoMonth, monthName } from "@/lib/content";

const SHOWN = 30;
const notes = await getNotes();
const months = [
	...new Map(notes.map((n) => [isoMonth(n.data.date), n.data.date])).entries(),
];
---

<Base title="Notes" description="Short, dated thoughts, often about something I read." crumbs={[{ label: "Notes" }]}>
	<h1>Notes</h1>
	<p class="filters">Short thoughts, and things I read with my take on them. <a href="/notes/rss.xml">rss</a></p>

	{notes.length === 0 && <p class="empty">No notes yet.</p>}
	{notes.slice(0, SHOWN).map((note) => <NoteBody note={note} />)}

	{
		months.length > 0 && (
			<section>
				<h2>Archive by month</h2>
				<ul class="inline-list">
					{months.map(([month, date]) => (
						<li>
							<a href={`/notes/${month.replace("-", "/")}/`}>{monthName(date)}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>
