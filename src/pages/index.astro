---
import { Picture } from "astro:assets";
import { render } from "astro:content";
import avatar from "@/assets/avatar.jpg";
import Section from "@/components/Section.astro";
import { site } from "@/config";
import Base from "@/layouts/Base.astro";
import {
	getLinks,
	getNotes,
	getPages,
	getPositions,
	getPosts,
	getTils,
	getTopics,
	getTrips,
	isoDate,
	linkItem,
	noteItem,
	positionItem,
	postItem,
	tilItem,
	topicUrl,
	tripItem,
} from "@/lib/content";
import { hubSections } from "@/lib/hub";

// Each block shows a fixed number of rows, so the homepage stays the same
// length however much is published. Full lists are on the section pages.
const LATEST = 5;
const LATEST_SHORT = 3;
const [posts, notes, links, pages, trips, tils, positions, topics] =
	await Promise.all([
		getPosts(),
		getNotes(),
		getLinks(),
		getPages(),
		getTrips(),
		getTils(),
		getPositions(),
		getTopics(),
	]);
const now = pages.find((page) => page.id === "now");
const Now = now ? (await render(now)).Content : null;
const hub = await hubSections();
---

<Base>
	<div class="intro">
		<Picture
			src={avatar}
			alt="Kanishk Pachauri, smiling, in a black open-source T-shirt"
			widths={[112, 224]}
			sizes="7rem"
			formats={["avif", "webp"]}
			class="avatar"
			loading="eager"
		/>
		<div>
			<h1>{site.name}</h1>
			<p>{site.intro}</p>
		</div>
	</div>
	{
		topics.length > 0 && (
			<p class="filters topics-line">
				Start with a topic:{" "}
				{topics.map((t, i) => (
					<>
						{i > 0 && " · "}
						<a href={topicUrl(t)}>{t.data.title}</a>
					</>
				))}
			</p>
		)
	}

	<section class="block">
		<div class="section-head">
			<h2><a href="/about/">More about me</a></h2>
			<a href="/about/">about →</a>
		</div>
		<ul class="hub-grid">
			{
				hub.map((s) => (
					<li>
						<a href={s.href}>{s.label}</a>
						<span class="detail">{s.detail}</span>
					</li>
				))
			}
		</ul>
	</section>

	{
		now && Now && (
			<section>
				<div class="section-head">
					<h2>
						<a href="/now/">Now</a>
						{now.isDraft && <span class="draft-mark">draft</span>}
					</h2>
					{now.data.updated && <span class="meta">updated {isoDate(now.data.updated)}</span>}
				</div>
				<Now />
			</section>
		)
	}

	<Section
		title="Notes"
		href="/notes/"
		more="all notes"
		items={notes.slice(0, LATEST).map(noteItem)}
		empty="No notes yet."
	/>

	<Section
		title="Writing"
		href="/writing/"
		more="all writing"
		items={posts
			.filter((post) => post.data.kind !== "poem")
			.slice(0, LATEST)
			.map(postItem)}
		empty="Nothing published yet."
	/>

	<Section
		title="Poems"
		href="/writing/poems/"
		more="all poems"
		items={posts
			.filter((post) => post.data.kind === "poem")
			.slice(0, LATEST_SHORT)
			.map(postItem)}
		empty="No poems yet."
	/>

	{
		positions.length > 0 && (
			<Section
				title="Positions"
				href="/positions/"
				more="all positions"
				items={positions.slice(0, LATEST_SHORT).map(positionItem)}
				empty=""
			/>
		)
	}

	<Section
		title="TILs"
		href="/tils/"
		more="all TILs"
		items={tils.slice(0, LATEST).map(tilItem)}
		empty="No TILs yet."
	/>

	<Section
		title="Travel"
		href="/travel/"
		more="all trips"
		items={trips.slice(0, LATEST_SHORT).map(tripItem)}
		empty="Trips and photos from India and abroad are on their way."
	>
		{trips.length > 0 && (
			<p class="meta">
				<a href="/photos/">all photos</a> · <a href="/travel/map/">map</a>
			</p>
		)}
	</Section>

	<Section
		title="Links"
		href="/links/"
		more="all links"
		items={links.slice(0, LATEST).map(linkItem)}
		empty="No links yet."
	/>
</Base>
