---
import { render } from "astro:content";
import Section from "@/components/Section.astro";
import { site } from "@/config";
import Base from "@/layouts/Base.astro";
import {
	getLinks,
	getNotes,
	getPages,
	getPosts,
	getTrips,
	isoDate,
	linkItem,
	noteItem,
	postItem,
	tripItem,
} from "@/lib/content";

// Each block shows a fixed number of rows, so the homepage stays the same
// length however much is published. Full lists are on the section pages.
const LATEST = 5;
const LATEST_SHORT = 3;
const [posts, notes, links, pages, trips] = await Promise.all([
	getPosts(),
	getNotes(),
	getLinks(),
	getPages(),
	getTrips(),
]);
const now = pages.find((page) => page.id === "now");
const Now = now ? (await render(now)).Content : null;
---

<Base>
	<p>{site.intro}</p>

	{
		now && Now && (
			<section>
				<div class="section-head">
					<h2>
						<a href="/now/">Now</a>
						{now.isDraft && <span class="draft-mark">draft</span>}
					</h2>
					{now.data.updated && <span class="meta">updated {isoDate(now.data.updated)}</span>}
				</div>
				<Now />
			</section>
		)
	}

	<Section
		title="Notes"
		href="/notes/"
		more="all notes"
		items={notes.slice(0, LATEST).map(noteItem)}
		empty="No notes yet."
	/>

	<Section
		title="Writing"
		href="/writing/"
		more="all writing"
		items={posts
			.filter((post) => post.data.kind !== "poem")
			.slice(0, LATEST)
			.map(postItem)}
		empty="Nothing published yet."
	/>

	<Section
		title="Poems"
		href="/writing/poems/"
		more="all poems"
		items={posts
			.filter((post) => post.data.kind === "poem")
			.slice(0, LATEST_SHORT)
			.map(postItem)}
		empty="No poems yet."
	/>

	<Section
		title="Travel"
		href="/travel/"
		more="all trips"
		items={trips.slice(0, LATEST_SHORT).map(tripItem)}
		empty="Trips and photos from India and abroad are on their way."
	>
		{trips.length > 0 && (
			<p class="meta">
				<a href="/photos/">all photos</a> · <a href="/travel/map/">map</a>
			</p>
		)}
	</Section>

	<Section
		title="Links"
		href="/links/"
		more="all links"
		items={links.slice(0, LATEST).map(linkItem)}
		empty="No links yet."
	/>
</Base>
