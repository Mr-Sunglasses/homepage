---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { getPages } from "@/lib/content";
import { hubSections } from "@/lib/hub";

// About: the page itself, then a hub of everything else about me.
const pages = await getPages();
const about = pages.find((page) => page.id === "about");
const Content = about ? (await render(about)).Content : null;
const sections = await hubSections();
---

<Base
	title="About"
	description={about?.data.description || "Who I am, what I do and what I think."}
	isDraft={about?.isDraft}
	searchable
	crumbs={[{ label: "About" }]}
>
	<h1>About</h1>
	{Content && <Content />}
	<section class="block">
		<div class="section-head">
			<h2>More about me</h2>
		</div>
		<ul class="rows hub">
			{
				sections.map((s) => (
					<li class="row">
						<a href={s.href}>{s.label}</a>
						<span class="detail">{s.detail}</span>
					</li>
				))
			}
		</ul>
	</section>
</Base>
