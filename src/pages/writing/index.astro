---
import KindFilter from "@/components/KindFilter.astro";
import YearList from "@/components/YearList.astro";
import Base from "@/layouts/Base.astro";
import { getPosts, type Kind, kinds, postItem } from "@/lib/content";

const posts = await getPosts();
const available = (Object.keys(kinds) as Kind[]).filter((kind) =>
	posts.some((post) => post.data.kind === kind),
);
---

<Base title="Writing" description="Articles, poems and longer thoughts." crumbs={[{ label: "Writing" }]}>
	<h1>Writing</h1>
	<KindFilter available={available} />
	<YearList items={posts.map(postItem)} />
</Base>
