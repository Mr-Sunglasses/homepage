---
import type { GetStaticPaths } from "astro";
import KindFilter from "@/components/KindFilter.astro";
import YearList from "@/components/YearList.astro";
import Base from "@/layouts/Base.astro";
import { getPosts, type Kind, kinds, postItem } from "@/lib/content";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	const available = (Object.keys(kinds) as Kind[]).filter((kind) =>
		posts.some((post) => post.data.kind === kind),
	);
	return available.map((kind) => ({
		params: { kind: kinds[kind].slug },
		props: {
			kind,
			available,
			posts: posts.filter((post) => post.data.kind === kind),
		},
	}));
}) satisfies GetStaticPaths;

const { kind, available, posts } = Astro.props;
const { label } = kinds[kind];
---

<Base title={label} crumbs={[{ label: "Writing", href: "/writing/" }, { label }]}>
	<h1>{label}</h1>
	<KindFilter active={kind} available={available} />
	<YearList items={posts.map(postItem)} />
</Base>
