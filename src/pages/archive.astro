---
import YearList from "@/components/YearList.astro";
import Base from "@/layouts/Base.astro";
import { getAllItems } from "@/lib/content";

const items = await getAllItems();
---

<Base title="Archive" description="Everything on this site, by year." crumbs={[{ label: "Archive" }]}>
	<h1>Archive</h1>
	<p class="filters">Everything I've published, newest first. Also by <a href="/tags/">tag</a>.</p>
	<YearList items={items} showSection />
</Base>
